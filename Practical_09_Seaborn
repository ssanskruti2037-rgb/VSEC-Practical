# Practical 9: Statistical Visualization using Seaborn
# Aim: Create statistical plots using Seaborn.

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt


# ---------------------------------------------------
# 1. Create sample dataset
# ---------------------------------------------------

data = {
    "Student": [
        "Amit", "Rahul", "Sneha", "Priya", "Neha",
        "Rohan", "Kiran", "Pooja", "Vikas", "Anjali"
    ],

    "Study_Hours": [
        2, 3, 4, 5, 6,
        7, 8, 3, 5, 6
    ],

    "Marks": [
        50, 55, 60, 65, 72,
        80, 90, 58, 68, 75
    ],

    "Branch": [
        "Computer", "IT", "Computer", "IT", "Computer",
        "IT", "Computer", "IT", "Computer", "IT"
    ]
}

df = pd.DataFrame(data)

print("--- Dataset ---")
print(df)


# ---------------------------------------------------
# 2. Set Seaborn style
# ---------------------------------------------------

sns.set_style("whitegrid")


# ---------------------------------------------------
# 3. Line Plot
# ---------------------------------------------------

print("\n--- Seaborn Line Plot ---")

plt.figure(figsize=(8, 5))

sns.lineplot(
    data=df,
    x="Study_Hours",
    y="Marks",
    marker="o"
)

plt.title("Study Hours vs Marks")
plt.xlabel("Study Hours")
plt.ylabel("Marks")

plt.show()


# ---------------------------------------------------
# 4. Bar Plot
# ---------------------------------------------------

print("\n--- Seaborn Bar Plot ---")

plt.figure(figsize=(8, 5))

sns.barplot(
    data=df,
    x="Branch",
    y="Marks"
)

plt.title("Average Marks by Branch")
plt.xlabel("Branch")
plt.ylabel("Average Marks")

plt.show()


# ---------------------------------------------------
# 5. Histogram
# ---------------------------------------------------

print("\n--- Seaborn Histogram ---")

plt.figure(figsize=(8, 5))

sns.histplot(
    data=df,
    x="Marks",
    bins=5,
    kde=True
)

plt.title("Distribution of Marks")
plt.xlabel("Marks")
plt.ylabel("Number of Students")

plt.show()


# ---------------------------------------------------
# 6. Box Plot
# ---------------------------------------------------

print("\n--- Seaborn Box Plot ---")

plt.figure(figsize=(8, 5))

sns.boxplot(
    data=df,
    x="Branch",
    y="Marks"
)

plt.title("Marks Distribution by Branch")
plt.xlabel("Branch")
plt.ylabel("Marks")

plt.show()


# ---------------------------------------------------
# 7. Scatter Plot
# ---------------------------------------------------

print("\n--- Seaborn Scatter Plot ---")

plt.figure(figsize=(8, 5))

sns.scatterplot(
    data=df,
    x="Study_Hours",
    y="Marks",
    hue="Branch",
    s=100
)

plt.title("Study Hours vs Marks")
plt.xlabel("Study Hours")
plt.ylabel("Marks")

plt.show()


# ---------------------------------------------------
# 8. Scatter Plot with Size
# ---------------------------------------------------

print("\n--- Scatter Plot with Size ---")

plt.figure(figsize=(8, 5))

sns.scatterplot(
    data=df,
    x="Study_Hours",
    y="Marks",
    hue="Branch",
    size="Marks",
    sizes=(50, 200)
)

plt.title("Study Hours vs Marks by Branch")
plt.xlabel("Study Hours")
plt.ylabel("Marks")

plt.show()


# ---------------------------------------------------
# 9. Line Plot for Different Branches
# ---------------------------------------------------

print("\n--- Line Plot by Branch ---")

plt.figure(figsize=(8, 5))

sns.lineplot(
    data=df,
    x="Study_Hours",
    y="Marks",
    hue="Branch",
    marker="o"
)

plt.title("Study Hours and Marks by Branch")
plt.xlabel("Study Hours")
plt.ylabel("Marks")

plt.legend(title="Branch")

plt.show()


# ---------------------------------------------------
# 10. Display summary statistics
# ---------------------------------------------------

print("\n--- Summary Statistics ---")

print(df.describe())
