# Practical 7: Data Visualization using Matplotlib
# Aim: Plot line, bar, scatter and histogram charts.

import matplotlib.pyplot as plt
import numpy as np


# ---------------------------------------------------
# 1. Line Plot
# ---------------------------------------------------

print("--- Line Plot ---")

x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 30, 25]

plt.figure(figsize=(7, 5))

plt.plot(
    x,
    y,
    marker="o",
    color="blue"
)

plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.title("Line Plot")

plt.grid(True)

plt.show()


# ---------------------------------------------------
# 2. Bar Plot
# ---------------------------------------------------

print("--- Bar Plot ---")

students = ["Amit", "Rahul", "Sneha", "Priya", "Neha"]
marks = [85, 90, 78, 92, 88]

plt.figure(figsize=(7, 5))

plt.bar(
    students,
    marks,
    color="green"
)

plt.xlabel("Students")
plt.ylabel("Marks")
plt.title("Student Marks - Bar Chart")

plt.show()


# ---------------------------------------------------
# 3. Scatter Plot
# ---------------------------------------------------

print("--- Scatter Plot ---")

study_hours = [1, 2, 3, 4, 5, 6, 7, 8]
marks = [45, 50, 55, 60, 65, 70, 78, 85]

plt.figure(figsize=(7, 5))

plt.scatter(
    study_hours,
    marks,
    color="red"
)

plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.title("Study Hours vs Marks")

plt.grid(True)

plt.show()


# ---------------------------------------------------
# 4. Histogram
# ---------------------------------------------------

print("--- Histogram ---")

marks_data = [
    45, 50, 55, 60, 62, 65, 67, 68,
    70, 72, 73, 75, 76, 78, 80, 82,
    85, 87, 88, 90, 92, 95, 96, 98
]

plt.figure(figsize=(7, 5))

plt.hist(
    marks_data,
    bins=5,
    color="orange",
    edgecolor="black"
)

plt.xlabel("Marks")
plt.ylabel("Number of Students")
plt.title("Distribution of Student Marks")

plt.show()


# ---------------------------------------------------
# 5. Line Plot with Different Styles
# ---------------------------------------------------

print("--- Styled Line Plot ---")

x = np.arange(1, 11)
y = x ** 2

plt.figure(figsize=(7, 5))

plt.plot(
    x,
    y,
    color="purple",
    marker="o",
    linestyle="--",
    linewidth=2
)

plt.xlabel("X")
plt.ylabel("X²")
plt.title("Square of Numbers")

plt.grid(True)

plt.show()


# ---------------------------------------------------
# 6. Comparing Two Lines
# ---------------------------------------------------

print("--- Multiple Line Plot ---")

x = [1, 2, 3, 4, 5]

y1 = [10, 20, 30, 40, 50]
y2 = [5, 15, 25, 35, 45]

plt.figure(figsize=(7, 5))

plt.plot(
    x,
    y1,
    marker="o",
    color="blue",
    label="Line 1"
)

plt.plot(
    x,
    y2,
    marker="s",
    color="red",
    label="Line 2"
)

plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.title("Comparison of Two Lines")

plt.legend()
plt.grid(True)

plt.show()
